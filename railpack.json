{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": { "commands": ["npm install"] },
    "build": { "inputs": [{ "step": "install" }], "commands": ["npm run build"] }
  },
  "deploy": {
    "startCommand": "npx serve -s dist/frontend_transporte_universitario/browser -l $PORT",
    "inputs": [{ "step": "build" }]
  }
}